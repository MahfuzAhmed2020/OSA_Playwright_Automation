<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Firefox login inspection">
    <parameter name="keep.browsers.open" value="true"/>
    <listeners>
        <listener class-name="com.osa.listeners.TestListener"/>
        <listener class-name="com.osa.listeners.KeepBrowsersOpenListener"/>
    </listeners>
    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes><class name="com.osa.runners.RunCucumberTest"/></classes>
    </test>
</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Practice Registration Suite" parallel="tests" thread-count="3">
    <parameter name="keepOpen" value="false"/>
    <listeners>
        <listener class-name="com.osa.practice_Plwrt.Practice_BrowserListener"/>
    </listeners>
    <test name="Firefox registration">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.osa.practice_Plwrt.Run_Practice_Test"/>
        </classes>
    </test>
    <test name="Chrome registration">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.osa.practice_Plwrt.Run_Practice_Test"/>
        </classes>
    </test>
    <test name="Edge registration">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.osa.practice_Plwrt.Run_Practice_Test"/>
        </classes>
    </test>
        <test name="webkit registration">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="com.osa.practice_Plwrt.Run_Practice_Test"/>
        </classes>
    </test>
</suite>
